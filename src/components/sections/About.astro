---
import Button from '../ui/Button.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="py-20 bg-transparent">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto">
      <!-- Section Title -->
      <h2 class="text-3xl lg:text-5xl font-display font-bold text-white mb-8">
        {t('about.title')}
      </h2>

      <!-- Content -->
      <div class="prose prose-invert prose-lg max-w-none">
        <p class="text-white/80 leading-relaxed mb-6">
          {t('about.p1')}
        </p>

        <p class="text-white/70 leading-relaxed mb-6">
          {t('about.p2')}
        </p>

        <p class="text-white/70 leading-relaxed mb-6">
          {t('about.p3')}
        </p>

        <p class="text-white/70 leading-relaxed mb-8">
          {t('about.p4')}
        </p>

        <!-- CTA -->
        <div class="flex gap-4">
          <Button href={translatePath('/sobre')} variant="primary">
            {t('about.cta.more')}
          </Button>
          <Button href={translatePath('/contato')} variant="secondary">
            {t('about.cta.contact')}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
