---
import Badge from '../ui/Badge.astro';
import { getAllTechnologies } from '../../data/tech-stack';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const technologies = getAllTechnologies();
---

<section class="py-20 bg-transparent">
  <div class="container-custom">
    <!-- Section Title -->
    <h2 class="text-3xl lg:text-5xl font-display font-bold text-white mb-4 text-center">
      {t('tech.title')}
    </h2>
    <p class="text-white/60 text-center mb-12 max-w-2xl mx-auto">
      {t('tech.subtitle')}
    </p>

    <!-- Tech Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
      {technologies.map((tech) => {
        const variant = tech.highlight === 'cyan'
          ? 'highlight-cyan'
          : tech.highlight === 'purple'
          ? 'highlight-purple'
          : 'default';

        return (
          <div class="flex items-center justify-center">
            <Badge variant={variant}>
              {tech.name}
            </Badge>
          </div>
        );
      })}
    </div>
  </div>
</section>
