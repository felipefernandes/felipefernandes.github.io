---
import Button from '../ui/Button.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="min-h-screen flex items-center justify-center bg-transparent py-20">
  <div class="container-custom text-center">
    <!-- Subtitle -->
    <p class="text-sm lg:text-base text-white/50 mb-6 font-mono uppercase tracking-wider">
      {t('hero.subtitle')}
    </p>

    <!-- Main Tagline -->
    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-display font-bold leading-tight mb-8">
      <span class="text-white block mb-2">{t('hero.tagline.1')}</span>
      <span class="text-white/80 block mb-2">{t('hero.tagline.2')}</span>
      <span class="text-white block">{t('hero.tagline.3')} <span class="text-neon-cyan">{t('hero.tagline.4')}</span></span>
    </h1>

    <!-- Description -->
    <p class="text-lg lg:text-xl text-white/50 max-w-3xl mx-auto mb-12 leading-relaxed">
      {t('hero.description')}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button href={translatePath('/projetos')} variant="primary" size="lg">
        {t('hero.cta.projects')}
      </Button>
      <Button href={translatePath('/contato')} variant="secondary" size="lg">
        {t('hero.cta.contact')}
      </Button>
    </div>

    <!-- Scroll Indicator -->
    <div class="mt-20 animate-bounce">
      <svg
        class="w-6 h-6 mx-auto text-white/20"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"
        />
      </svg>
    </div>
  </div>
</section>
