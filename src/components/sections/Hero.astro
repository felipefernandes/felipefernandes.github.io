---
import Button from '../ui/Button.astro';
---

<section class="min-h-screen flex items-center justify-center bg-transparent py-20">
  <div class="container-custom text-center">
    <!-- Subtitle -->
    <p class="text-sm lg:text-base text-white/50 mb-6 font-mono uppercase tracking-wider">
      AI Solutions Engineer & Architect · Agentic Systems · LLM Pipelines · Automação de Fluxos de Trabalho
    </p>

    <!-- Main Tagline -->
    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-display font-bold leading-tight mb-8">
      <span class="text-white block mb-2">Transformo</span>
      <span class="text-white/80 block mb-2">complexidade operacional</span>
      <span class="text-white block">em sistemas <span class="text-neon-cyan">simples</span></span>
    </h1>

    <!-- Description -->
    <p class="text-lg lg:text-xl text-white/50 max-w-3xl mx-auto mb-12 leading-relaxed">
      Especialista em arquitetar e implantar sistemas baseados em agentes autônomos e fluxos inteligentes de automação de processos, combinando excelência técnica com alta eficiência operacional.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button href="/projetos" variant="primary" size="lg">
        Ver Projetos
      </Button>
      <Button href="/contato" variant="secondary" size="lg">
        Fale Comigo
      </Button>
    </div>

    <!-- Scroll Indicator -->
    <div class="mt-20 animate-bounce">
      <svg
        class="w-6 h-6 mx-auto text-white/20"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"
        />
      </svg>
    </div>
  </div>
</section>
