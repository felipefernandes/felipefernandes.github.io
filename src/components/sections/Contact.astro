---
import Button from '../ui/Button.astro';
---

<section class="py-20 bg-gradient-to-b from-bg-primary to-bg-darker">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto text-center">
      <!-- Section Title -->
      <h2 class="text-3xl lg:text-5xl font-display font-bold text-white mb-6">
        Vamos conversar?
      </h2>

      <p class="text-xl text-white/50 mb-12 leading-relaxed">
        Trabalho com times e profissionais que querem modernizar processos com Agilidade e IA.
      </p>

      <!-- Contact Options -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <!-- Email -->
        <a
          href="mailto:felipefernandesweb@gmail.com"
          class="flex items-center gap-4 p-6 bg-bg-secondary border border-white/10 rounded-lg hover:border-white/20 transition-all duration-300"
        >
          <svg class="w-8 h-8 text-white/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <div class="text-left">
            <p class="text-sm text-white/40 font-mono uppercase">Email</p>
            <p class="text-white/80 font-mono text-sm">felipefernandesweb@gmail.com</p>
          </div>
        </a>

        <!-- WhatsApp -->
        <a
          href="https://wa.me/5521981184116"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-6 bg-bg-secondary border border-white/10 rounded-lg hover:border-white/20 transition-all duration-300"
        >
          <svg class="w-8 h-8 text-white/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <div class="text-left">
            <p class="text-sm text-white/40 font-mono uppercase">WhatsApp</p>
            <p class="text-white/80 font-mono text-sm">+55 21 98118-4116</p>
          </div>
        </a>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/contato" variant="primary" size="lg">
          Página de Contato
        </Button>
        <Button
          href="https://www.linkedin.com/in/felipefernand10/"
          variant="secondary"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </Button>
      </div>
    </div>
  </div>
</section>
