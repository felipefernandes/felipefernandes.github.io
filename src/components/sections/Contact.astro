---
import Button from '../ui/Button.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="py-20 bg-gradient-to-b from-bg-primary to-bg-darker">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto text-center">
      <!-- Section Title -->
      <h2 class="text-3xl lg:text-5xl font-display font-bold text-white mb-6">
        {t('contact.title')}
      </h2>

      <p class="text-xl text-white/50 mb-12 leading-relaxed">
        {t('contact.subtitle')}
      </p>

      <!-- Contact Options -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <!-- Email -->
        <a
          href="mailto:felipefernandesweb@gmail.com"
          class="flex items-center gap-4 p-6 bg-bg-secondary border border-white/10 rounded-lg hover:border-white/20 transition-all duration-300"
        >
          <svg class="w-8 h-8 text-white/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <div class="text-left">
            <p class="text-sm text-white/40 font-mono uppercase">Email</p>
            <p class="text-white/80 font-mono text-sm">felipefernandesweb@gmail.com</p>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/felipefernand10/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-6 bg-bg-secondary border border-white/10 rounded-lg hover:border-white/20 transition-all duration-300"
        >
          <svg class="w-8 h-8 text-white/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
          </svg>
          <div class="text-left">
            <p class="text-sm text-white/40 font-mono uppercase">LinkedIn</p>
            <p class="text-white/80 font-mono text-sm">linkedin.com/in/felipefernand10</p>
          </div>
        </a>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={translatePath('/contato')} variant="primary" size="lg">
          {t('contact.cta.page')}
        </Button>
        <Button
          href="https://github.com/felipefernandes"
          variant="secondary"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </Button>
      </div>
    </div>
  </div>
</section>
