---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const socialLinks = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/felipefernand10/',
    icon: 'linkedin',
  },
  {
    name: 'GitHub',
    href: 'https://github.com/felipefernandes',
    icon: 'github',
  },
  {
    name: 'Email',
    href: 'mailto:felipefernandesweb@gmail.com',
    icon: 'mail',
  },
];

const currentYear = new Date().getFullYear();

const getIcon = (iconName: string) => {
  const icons: Record<string, string> = {
    linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
    github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
    mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
    message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  };
  return icons[iconName] || '';
};
---

<footer class="bg-bg-darker border-t border-white/10 mt-24">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="text-lg font-display font-bold text-white mb-4">Felipe Fernandes</h3>
        <p class="text-white/40 text-sm leading-relaxed font-mono">
          {t('footer.description')}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-display font-bold text-white mb-4">{t('footer.links')}</h3>
        <nav class="flex flex-col gap-2">
          <a href={translatePath('/sobre')} class="text-white/40 hover:text-white transition-colors text-sm uppercase font-mono tracking-wider">{t('nav.about')}</a>
          <a href={translatePath('/projetos')} class="text-white/40 hover:text-white transition-colors text-sm uppercase font-mono tracking-wider">{t('nav.projects')}</a>
          <a href={translatePath('/artigos')} class="text-white/40 hover:text-white transition-colors text-sm uppercase font-mono tracking-wider">{t('nav.articles')}</a>
          <a href={translatePath('/palestras')} class="text-white/40 hover:text-white transition-colors text-sm uppercase font-mono tracking-wider">{t('nav.talks')}</a>
        </nav>
      </div>

      <!-- Social Links -->
      <div>
        <h3 class="text-lg font-display font-bold text-white mb-4">{t('footer.connect')}</h3>
        <div class="flex gap-4">
          {socialLinks.map(({ name, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-lg border border-white/10 text-white/50 hover:text-white hover:border-white/30 transition-all duration-300"
              aria-label={name}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <Fragment set:html={getIcon(icon)} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-white/10 text-center">
      <p class="text-white/30 text-sm font-mono">
        © {currentYear} Felipe Fernandes. {t('footer.builtWith')}
      </p>
    </div>
  </div>
</footer>
