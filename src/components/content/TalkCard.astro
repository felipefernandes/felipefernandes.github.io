---
import Card from '../ui/Card.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export interface Props {
  title: string;
  event: string;
  type: 'talk' | 'workshop' | 'mentorship' | 'community';
  date: Date;
  description: string;
  videoUrl?: string;
}

const { title, event, type, date, description, videoUrl } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const typeLabels = {
  talk: t('talks.type.talk'),
  workshop: t('talks.type.workshop'),
  mentorship: t('talks.type.mentorship'),
  community: t('talks.type.community'),
};

const typeIcons = {
  talk: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/>',
  workshop: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/>',
  mentorship: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  community: '<path d="M17 21v-2a3 3 0 0 0-3-3H8a3 3 0 0 0-3 3v2"/><circle cx="9.5" cy="7" r="4"/><path d="M23 21v-2a3 3 0 0 0-3-3H16"/><circle cx="18" cy="8" r="3"/>',
};

const formattedDate = date.toLocaleDateString(lang === 'en' ? 'en-US' : 'pt-BR', {
  year: 'numeric',
  month: 'short',
});

const hasVideo = !!(videoUrl && videoUrl !== '' && videoUrl !== '#');
---

<Card hoverable={hasVideo} class="group">
  <div class="flex flex-col h-full">
    <!-- Header -->
    <div class="flex items-center gap-3 mb-4">
      <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <Fragment set:html={typeIcons[type]} />
      </svg>
      <span class="text-xs font-mono uppercase tracking-wider text-white/40">
        {typeLabels[type]}
      </span>
      <span class="text-white/20">•</span>
      <span class="text-xs font-mono text-white/40">
        {formattedDate}
      </span>
    </div>

    <!-- Event -->
    <p class="text-sm text-white/60 font-mono mb-2">
      {t('talks.event')} {event}
    </p>

    <!-- Title -->
    <h3 class="text-xl font-display font-bold text-white mb-3">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-white/70 text-sm leading-relaxed mb-auto">
      {description}
    </p>

    <!-- Footer -->
    {hasVideo && (
      <div class="flex items-center justify-between pt-4 mt-4 border-t border-white/10">
        <a
          href={videoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors font-mono uppercase tracking-wider"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          {t('talks.video')}
        </a>
      </div>
    )}
  </div>
</Card>
