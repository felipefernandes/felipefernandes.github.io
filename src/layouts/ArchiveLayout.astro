---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  date: Date;
  categories: string[];
}

const { title, date, categories } = Astro.props;

const formattedDate = date.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${title} - Arquivo`}
  description="Post arquivado do antigo blog (2014-2015)"
>
  <article class="py-20 bg-bg-primary">
    <div class="container-custom max-w-4xl mx-auto">
      <!-- Disclaimer Banner -->
      <div class="mb-12 p-6 bg-white/5 border border-white/10 rounded-lg">
        <div class="flex items-start gap-4">
          <svg class="w-6 h-6 text-white/60 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <h3 class="text-sm font-mono uppercase tracking-wider text-white/80 mb-2">
              Conteúdo Arquivado
            </h3>
            <p class="text-sm text-white/60 leading-relaxed">
              Este artigo foi publicado em {formattedDate} no antigo blog. O conteúdo pode estar desatualizado e é mantido apenas para fins de arquivo histórico.
            </p>
          </div>
        </div>
      </div>

      <!-- Post Header -->
      <header class="mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          {categories.map((category) => (
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-wider bg-white/5 border border-white/10 rounded-full text-white/60">
              {category}
            </span>
          ))}
        </div>
        <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-4">
          {title}
        </h1>
        <time class="text-sm text-white/40 font-mono">
          {formattedDate}
        </time>
      </header>

      <!-- Post Content -->
      <div class="prose prose-invert prose-lg max-w-none">
        <slot />
      </div>

      <!-- Back Link -->
      <div class="mt-12 pt-8 border-t border-white/10">
        <a
          href="/arquivo"
          class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Voltar para o arquivo
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .prose {
    color: rgba(255, 255, 255, 0.7);
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 700;
  }

  .prose :global(strong) {
    color: rgba(255, 255, 255, 0.9);
  }

  .prose :global(a) {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }

  .prose :global(a:hover) {
    color: white;
    text-decoration-color: rgba(255, 255, 255, 0.6);
  }

  .prose :global(code) {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .prose :global(pre) {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .prose :global(blockquote) {
    border-left-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.6);
  }

  .prose :global(img) {
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .prose :global(iframe) {
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 100%;
  }
</style>
