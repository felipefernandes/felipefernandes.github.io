---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';

export interface Props {
  title: string;
  description: string;
  tags: string[];
  status: 'open-source' | 'saas' | 'internal' | 'archived';
  year: number;
  link?: string;
  github?: string;
}

const { title, description, tags, status, year, link, github } = Astro.props;

const statusLabels = {
  'open-source': 'Open Source',
  'saas': 'SaaS',
  'internal': 'Interno',
  'archived': 'Arquivado',
};
---

<BaseLayout title={`${title} | Felipe Fernandes`} description={description}>
  <main class="pt-24 pb-20">
    <div class="container-custom">
      <article class="max-w-4xl mx-auto">
        <!-- Back button -->
        <a
          href="/projetos"
          class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors mb-8 font-mono uppercase tracking-wider"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Voltar
        </a>

        <!-- Header -->
        <header class="mb-12">
          <div class="flex items-center gap-3 mb-4 flex-wrap">
            <span class="text-sm font-mono uppercase tracking-wider text-white/40">
              {statusLabels[status]}
            </span>
            <span class="text-white/20">•</span>
            <span class="text-sm font-mono text-white/40">
              {year}
            </span>
          </div>

          <h1 class="text-4xl lg:text-6xl font-display font-bold text-white mb-6">
            {title}
          </h1>

          <p class="text-xl text-white/70 leading-relaxed mb-8">
            {description}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-8">
            {tags.map((tag) => (
              <Badge variant="default">{tag}</Badge>
            ))}
          </div>

          <!-- Links -->
          <div class="flex flex-wrap gap-4">
            {link && (
              <Button
                href={link}
                variant="primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver Projeto
              </Button>
            )}
            {github && (
              <Button
                href={github}
                variant="secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </Button>
            )}
          </div>
        </header>

        <!-- Content -->
        <div class="prose prose-invert prose-lg max-w-none">
          <slot />
        </div>

        <!-- Footer CTA -->
        <footer class="mt-16 pt-8 border-t border-white/10">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-white/60 text-sm font-mono">
              Gostou deste projeto?
            </p>
            <div class="flex gap-3">
              <Button href="/projetos" variant="ghost">
                Ver Mais Projetos
              </Button>
              <Button href="/contato" variant="secondary">
                Entre em Contato
              </Button>
            </div>
          </div>
        </footer>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  /* Prose styles for markdown content */
  :global(.prose) {
    @apply text-white/80;
  }

  :global(.prose h2) {
    @apply text-2xl lg:text-4xl font-display font-bold text-white mt-12 mb-6;
  }

  :global(.prose h3) {
    @apply text-xl lg:text-2xl font-display font-semibold text-white mt-8 mb-4;
  }

  :global(.prose h4) {
    @apply text-lg lg:text-xl font-display font-semibold text-white mt-6 mb-3;
  }

  :global(.prose p) {
    @apply text-white/70 leading-relaxed mb-4;
  }

  :global(.prose ul) {
    @apply list-disc list-inside text-white/70 space-y-2 mb-4;
  }

  :global(.prose ol) {
    @apply list-decimal list-inside text-white/70 space-y-2 mb-4;
  }

  :global(.prose li) {
    @apply text-white/70;
  }

  :global(.prose strong) {
    @apply text-white font-semibold;
  }

  :global(.prose a) {
    @apply text-white underline hover:text-white/80 transition-colors;
  }

  :global(.prose code) {
    @apply bg-white/5 border border-white/10 rounded px-2 py-1 text-sm font-mono text-white/90;
  }

  :global(.prose pre) {
    @apply bg-bg-secondary border border-white/10 rounded-lg p-4 overflow-x-auto mb-6;
  }

  :global(.prose pre code) {
    @apply bg-transparent border-0 p-0;
  }

  :global(.prose blockquote) {
    @apply border-l-4 border-white/20 pl-4 italic text-white/60 my-6;
  }
</style>
