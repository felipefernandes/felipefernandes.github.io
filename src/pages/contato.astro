---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/felipefernand10/',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
    description: 'Perfil profissional e networking',
  },
  {
    name: 'GitHub',
    href: 'https://github.com/felipefernandes',
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
    description: 'Projetos open source',
  },
  {
    name: 'Medium',
    href: 'https://medium.com/@felipefernandes',
    icon: '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 13.5v-7l6 3.5-6 3.5z"/>',
    description: 'Artigos sobre engenharia de IA e agilidade',
  },
  {
    name: 'Email',
    href: 'mailto:felipefernandesweb@gmail.com',
    icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
    description: 'felipefernandesweb@gmail.com',
  },
  {
    name: 'WhatsApp',
    href: 'https://wa.me/5521981184116',
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
    description: '+55 21 98118-4116',
  },
];
---

<BaseLayout
  title="Contato | Felipe Fernandes"
  description="Entre em contato com Felipe Fernandes para palestras, mentorias, consultorias ou parcerias"
>
  <main class="pt-24 pb-20">
    <div class="container-custom">
      <!-- Header -->
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h1 class="text-4xl lg:text-6xl font-display font-bold text-white mb-6">
          Vamos conversar?
        </h1>
        <p class="text-xl text-white/60 leading-relaxed">
          Trabalho com times e profissionais que querem modernizar processos combinando engenharia de IA e agilidade organizacional.
          Entre em contato para palestras, mentorias, consultorias ou parcerias.
        </p>
      </div>

      <!-- Contact Options -->
      <div class="max-w-4xl mx-auto mb-20">
        <h2 class="text-2xl font-display font-bold text-white mb-8">
          Canais de Contato
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {socialLinks.map(({ name, href, icon, description }) => (
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="flex items-start gap-4 p-6 bg-bg-secondary border border-white/10 rounded-lg hover:border-white/20 transition-all duration-300 group"
            >
              <div class="flex-shrink-0 p-3 bg-white/5 border border-white/10 rounded-lg group-hover:bg-white/10 transition-all">
                <svg class="w-6 h-6 text-white/40 group-hover:text-white/60 transition-colors" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <Fragment set:html={icon} />
                </svg>
              </div>
              <div class="flex-grow">
                <h3 class="text-lg font-display font-semibold text-white mb-1 group-hover:text-white/90 transition-colors">
                  {name}
                </h3>
                <p class="text-sm text-white/60 font-mono">
                  {description}
                </p>
              </div>
              <svg class="w-5 h-5 text-white/20 group-hover:text-white/40 group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Topics -->
      <div class="max-w-4xl mx-auto mb-20">
        <h2 class="text-2xl font-display font-bold text-white mb-8">
          Temas de Interesse
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 bg-white/5 border border-white/10 rounded-lg">
            <h3 class="text-lg font-display font-semibold text-white mb-3">
              Palestras & Workshops
            </h3>
            <ul class="text-white/70 text-sm space-y-2">
              <li>• Agentic Systems & AI Agents em produção</li>
              <li>• Pipelines de LLM e arquiteturas RAG</li>
              <li>• Automação de fluxos de trabalho e processos</li>
              <li>• Governança e políticas de adoção de IA</li>
            </ul>
          </div>

          <div class="p-6 bg-white/5 border border-white/10 rounded-lg">
            <h3 class="text-lg font-display font-semibold text-white mb-3">
              Consultorias & Mentorias
            </h3>
            <ul class="text-white/70 text-sm space-y-2">
              <li>• Implantação de práticas de fluxo e agilidade</li>
              <li>• Desenho e orquestração de agentes de IA</li>
              <li>• Métricas de fluxo e inteligência operacional</li>
              <li>• Liderança e governança de times de tech/IA</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Location -->
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 text-white/40 font-mono text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>São Paulo, SP · Brasil</span>
          <span class="text-white/20">•</span>
          <span>Atendimento remoto e presencial</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
